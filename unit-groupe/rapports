<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rapports — Unit Groupe × Agence Lak.</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #f5f5f3;
      color: #1a1a18;
      min-height: 100vh;
      padding: 3rem 1rem;
    }

    .wrapper {
      max-width: 860px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid rgba(0,0,0,0.07);
      padding: 2.5rem;
    }

    /* TOPBAR */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(0,0,0,0.07);
    }

    .logo {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 17px;
      color: #1a1a18;
      letter-spacing: -0.3px;
    }

    .logo em { color: #E8621A; font-style: normal; }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .client-name { font-size: 13px; color: rgba(0,0,0,0.4); }

    .status-pill {
      font-size: 11px;
      font-weight: 500;
      padding: 4px 10px;
      border-radius: 20px;
      background: #FFF0E8;
      color: #B84D10;
      border: 1px solid #F5C4A0;
    }

    /* HEADER */
    .page-header {
      margin-bottom: 2.5rem;
    }

    .page-title {
      font-family: 'Syne', sans-serif;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .page-sub {
      font-size: 14px;
      color: rgba(0,0,0,0.45);
      line-height: 1.6;
    }

    /* ACCORDION LIST */
    .accordion-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* ACCORDION ITEM */
    .accordion {
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.08);
      overflow: hidden;
      transition: border-color 0.2s;
    }

    .accordion.active {
      border-color: #E8621A;
    }

    .accordion.locked {
      opacity: 0.45;
      pointer-events: none;
    }

    .accordion-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.1rem 1.25rem;
      cursor: pointer;
      user-select: none;
      background: #ffffff;
      gap: 12px;
    }

    .accordion.locked .accordion-header {
      background: #fafaf8;
      cursor: default;
    }

    .accordion-header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .acc-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #E8621A;
      flex-shrink: 0;
    }

    .accordion.locked .acc-dot {
      background: rgba(0,0,0,0.15);
    }

    .acc-period {
      font-family: 'Syne', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: #1a1a18;
    }

    .accordion.locked .acc-period {
      color: rgba(0,0,0,0.4);
    }

    .acc-badge {
      font-size: 11px;
      font-weight: 500;
      padding: 3px 10px;
      border-radius: 20px;
      background: #FFF0E8;
      color: #B84D10;
      border: 1px solid #F5C4A0;
    }

    .acc-badge.upcoming {
      background: #f5f5f3;
      color: rgba(0,0,0,0.3);
      border-color: rgba(0,0,0,0.08);
    }

    .acc-chevron {
      width: 18px;
      height: 18px;
      color: rgba(0,0,0,0.3);
      transition: transform 0.25s;
      flex-shrink: 0;
    }

    .accordion.open .acc-chevron {
      transform: rotate(180deg);
      color: #E8621A;
    }

    /* ACCORDION BODY */
    .accordion-body {
      display: none;
      padding: 0 1.25rem 1.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
    }

    .accordion.open .accordion-body {
      display: block;
    }

    /* STATS ROW */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .stat-card {
      background: #f9f9f7;
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 10px;
      padding: 1rem;
      text-align: center;
    }

    .stat-value {
      font-family: 'Syne', sans-serif;
      font-size: 26px;
      font-weight: 700;
      color: #E8621A;
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 11px;
      color: rgba(0,0,0,0.4);
      line-height: 1.4;
    }

    /* SECTION TITLE */
    .section-title {
      font-size: 11px;
      font-weight: 500;
      color: rgba(0,0,0,0.3);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 1rem;
      margin-top: 1.5rem;
    }

    /* DELIVERABLE ITEMS */
    .deliverables {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .deliverable {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: #f9f9f7;
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 10px;
      padding: 1rem 1.1rem;
    }

    .deliverable-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #FFF0E8;
      border: 1px solid #F5C4A0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }

    .deliverable-content {}

    .deliverable-title {
      font-size: 13px;
      font-weight: 500;
      color: #1a1a18;
      margin-bottom: 3px;
    }

    .deliverable-desc {
      font-size: 12px;
      color: rgba(0,0,0,0.45);
      line-height: 1.55;
    }

    .check-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 500;
      color: #1a7a52;
      background: #f0faf6;
      border: 1px solid #b2dfc9;
      border-radius: 20px;
      padding: 2px 8px;
      margin-top: 5px;
    }

    /* NEXT STEPS */
    .next-steps {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .next-step {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 8px;
      font-size: 13px;
      color: rgba(0,0,0,0.6);
    }

    .next-step-num {
      font-family: 'Syne', sans-serif;
      font-size: 11px;
      font-weight: 700;
      color: #E8621A;
      min-width: 18px;
    }

    /* NOTE */
    .note {
      margin-top: 1.25rem;
      background: #f9f9f7;
      border-left: 3px solid #E8621A;
      border-radius: 0 8px 8px 0;
      padding: 0.9rem 1rem;
      font-size: 13px;
      color: rgba(0,0,0,0.55);
      line-height: 1.6;
    }

    /* FOOTER */
    .footer {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(0,0,0,0.07);
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 2.5rem;
    }

    .footer-brand {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: #1a1a18;
    }

    .footer-brand em { color: #E8621A; font-style: normal; }
    .footer-credit { font-size: 11px; color: rgba(0,0,0,0.25); }

    @media (max-width: 520px) {
      .wrapper { padding: 1.5rem; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .footer { flex-direction: column; gap: 1rem; align-items: flex-start; }
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="logo">Agence Lak<em>.</em></div>
      <div class="topbar-right">
        <span class="client-name">Unit Groupe</span>
        <span class="status-pill">En cours</span>
      </div>
    </div>

    <!-- HEADER -->
    <div class="page-header">
      <div class="page-title">Rapports prestation de développement et maintenance</div>
      <div class="page-sub">Suivi mensuel de l'avancement, des livrables et des prochaines étapes.</div>
    </div>

    <!-- ACCORDION LIST -->
    <div class="accordion-list">

      <!-- MOIS 1 — ACTIF -->
      <div class="accordion active open" id="acc-1">
        <div class="accordion-header" onclick="toggleAccordion('acc-1')">
          <div class="accordion-header-left">
            <div class="acc-dot"></div>
            <div class="acc-period">18 juin — 18 juillet 2025</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span class="acc-badge">Rapport actif</span>
            <svg class="acc-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="accordion-body">

          <!-- LIVRABLES -->
          <div class="section-title">Livrables du mois</div>
          <div class="deliverables">

            <div class="deliverable">
              <div class="deliverable-icon">🚀</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Livraison CRM Scraping IA & Veille IA</div>
                <div class="deliverable-desc">Mise en production des deux premières solutions avec premières utilisations et retours intégrés. Un guide d'utilisation complet a été rédigé et remis.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

            <div class="deliverable">
              <div class="deliverable-icon">🎨</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Refonte complète de l'interface CRM</div>
                <div class="deliverable-desc">Refonte complète pour correspondre à l'organisation Trello : commentaires, formats de cartes, liaisons inter-éléments et prise en compte des besoins remontés.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

            <div class="deliverable">
              <div class="deliverable-icon">📋</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Création du tableau Besoins</div>
                <div class="deliverable-desc">Mise en place d'un tableau dédié à la gestion des besoins, directement intégré à l'application.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

            <div class="deliverable">
              <div class="deliverable-icon">📥</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Importation des cartes candidats, vivier & besoins</div>
                <div class="deliverable-desc">Transfert et structuration de l'ensemble des données existantes dans la nouvelle application — candidats, vivier et fiches besoins inclus.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

            <div class="deliverable">
              <div class="deliverable-icon">🗂</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Système de gestion des cartes par métier & fiche entretien</div>
                <div class="deliverable-desc">Mise en place d'un système de catégorisation par métier et création de la fiche entretien associée à chaque candidat.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

            <div class="deliverable">
              <div class="deliverable-icon">🗄</div>
              <div class="deliverable-content">
                <div class="deliverable-title">Importation des 2 200 candidats en BDD Laura</div>
                <div class="deliverable-desc">Intégration de l'intégralité de la base candidats existante dans la base de données de l'application.</div>
                <span class="check-tag">✓ Livré</span>
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- MOIS 2 — GRISÉ -->
      <div class="accordion locked">
        <div class="accordion-header">
          <div class="accordion-header-left">
            <div class="acc-dot"></div>
            <div class="acc-period">18 juillet — 18 août 2025</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span class="acc-badge upcoming">À venir</span>
            <svg class="acc-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- MOIS 3 — GRISÉ -->
      <div class="accordion locked">
        <div class="accordion-header">
          <div class="accordion-header-left">
            <div class="acc-dot"></div>
            <div class="acc-period">18 août — 18 septembre 2025</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span class="acc-badge upcoming">À venir</span>
            <svg class="acc-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- MOIS 4 — GRISÉ -->
      <div class="accordion locked">
        <div class="accordion-header">
          <div class="accordion-header-left">
            <div class="acc-dot"></div>
            <div class="acc-period">18 septembre — 18 octobre 2025</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span class="acc-badge upcoming">À venir</span>
            <svg class="acc-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- MOIS 5 — GRISÉ -->
      <div class="accordion locked">
        <div class="accordion-header">
          <div class="accordion-header-left">
            <div class="acc-dot"></div>
            <div class="acc-period">18 octobre — 18 novembre 2025</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span class="acc-badge upcoming">À venir</span>
            <svg class="acc-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>

    </div>

    <!-- FOOTER -->
    <div class="footer">
      <div class="footer-brand">Agence Lak<em>.</em></div>
      <div class="footer-credit">Rapport mensuel créé pour Unit Groupe</div>
    </div>

  </div>

  <script>
    function toggleAccordion(id) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.toggle('open');
    }
  </script>
</body>
</html>
