<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vinessen × Agence Lak — Stratégie Prospection Internationale</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --noir: #0a0a0a;
    --encre: #111114;
    --verre: #1a1a20;
    --bordeaux: #7c2d3e;
    --bordeaux-clair: #a83a50;
    --or: #c8a96e;
    --or-pale: #e8d5a8;
    --gris-fume: #2a2a30;
    --gris-moyen: #666672;
    --gris-clair: #9898a8;
    --blanc-casse: #f0ede8;
    --blanc: #fafaf8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--noir);
    color: var(--blanc-casse);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* ─── GRAIN OVERLAY ─── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.6;
  }

  /* ─── NAV ─── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem;
    background: linear-gradient(to bottom, rgba(10,10,10,0.95), transparent);
    backdrop-filter: blur(8px);
  }

  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.3em;
    color: var(--or);
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--gris-clair);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .nav-links a:hover { color: var(--or); }


  /* ─── SECTIONS ─── */
  section {
    padding: 8rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  section:first-of-type {
    padding-top: 10rem;
  }

  .section-label {
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-label::after {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    background: var(--or);
    opacity: 0.4;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--blanc);
    margin-bottom: 1.5rem;
  }

  .section-title em {
    font-style: italic;
    color: var(--or-pale);
  }

  .section-intro {
    font-size: 0.9rem;
    color: var(--gris-moyen);
    max-width: 580px;
    line-height: 1.9;
    margin-bottom: 5rem;
  }

  /* ─── VIDEO THUMBNAIL MOCKUP ─── */
  .email-video-thumb {
    position: relative;
    width: 100%;
    height: 200px;
    background:
      radial-gradient(ellipse 80% 60% at 50% 70%, rgba(90,20,30,0.6) 0%, transparent 70%),
      linear-gradient(160deg, #0c0608 0%, #18080e 45%, #0a0c10 100%);
    border-radius: 3px;
    margin: 1rem 0 0.4rem;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid rgba(200,169,110,0.12);
  }

  /* Décor lignes subtiles */
  .thumb-deco-lines {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 60px,
        rgba(200,169,110,0.02) 60px,
        rgba(200,169,110,0.02) 61px
      );
  }

  /* Bouteille stylisée en SVG inline via pseudo */
  .thumb-bottle {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -55%);
    width: 28px;
    height: 70px;
    background: linear-gradient(to bottom, rgba(200,169,110,0.06) 0%, rgba(200,169,110,0.02) 100%);
    border: 1px solid rgba(200,169,110,0.08);
    border-radius: 4px 4px 2px 2px;
    opacity: 0.5;
  }

  .thumb-bottle::before {
    content: '';
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 20px;
    background: rgba(200,169,110,0.06);
    border: 1px solid rgba(200,169,110,0.08);
    border-bottom: none;
    border-radius: 2px 2px 0 0;
  }

  /* Texte personnalisé centré — LA variable qui change */
  .thumb-personalization {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    z-index: 2;
  }

  .thumb-company-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--or-pale);
    letter-spacing: 0.08em;
    text-shadow: 0 2px 12px rgba(0,0,0,0.8);
  }

  .thumb-separator {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.75rem;
    color: rgba(200,169,110,0.4);
    letter-spacing: 0.2em;
  }

  .thumb-vinessen {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.75rem;
    font-style: italic;
    color: rgba(200,169,110,0.55);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
  }

  .video-play-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255,255,255,0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: #111;
    padding-left: 3px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    margin-top: 60px;
  }

  .video-bottom-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 22px;
    background: rgba(0,0,0,0.55);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.8rem;
    z-index: 4;
  }

  .video-duration {
    font-size: 0.62rem;
    color: var(--gris-clair);
    font-variant-numeric: tabular-nums;
  }


  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(200,169,110,0.2), transparent);
    margin: 0;
  }

  /* ─── PROCESS STEPS ─── */
  .process-grid {
    display: grid;
    gap: 2px;
  }

  .process-step {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0;
    background: var(--verre);
    border: 1px solid rgba(200,169,110,0.08);
    transition: border-color 0.4s, background 0.4s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }

  .process-step::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--bordeaux);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s ease;
  }

  .process-step:hover::before { transform: scaleY(1); }
  .process-step:hover {
    border-color: rgba(200,169,110,0.2);
    background: rgba(26,26,32,0.9);
  }

  .step-index {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    border-right: 1px solid rgba(200,169,110,0.08);
  }

  .step-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.7rem;
    color: var(--or);
    opacity: 0.5;
    letter-spacing: 0.1em;
    margin-top: 0.3rem;
  }

  .step-body {
    padding: 2.5rem;
  }

  .step-tag {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--bordeaux-clair);
    border: 1px solid rgba(168,58,80,0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    margin-bottom: 1rem;
  }

  .step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--blanc);
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.85rem;
    color: var(--gris-moyen);
    line-height: 1.85;
    margin-bottom: 1.2rem;
  }

  .step-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .tool-badge {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--gris-clair);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 2px;
  }

  .step-detail {
    margin-top: 1.2rem;
    padding: 1.2rem;
    background: rgba(0,0,0,0.3);
    border-left: 2px solid rgba(200,169,110,0.2);
  }

  .step-detail p {
    font-size: 0.8rem;
    color: var(--gris-clair);
    line-height: 1.8;
    font-family: 'DM Sans', monospace;
  }

  .step-detail .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.8rem;
  }

  .flow-item {
    font-size: 0.7rem;
    color: var(--or-pale);
    background: rgba(200,169,110,0.06);
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(200,169,110,0.15);
  }

  .flow-arrow {
    color: var(--bordeaux-clair);
    font-size: 0.7rem;
    opacity: 0.6;
  }

  /* ─── EMAIL MOCKUP ─── */
  .email-mockup {
    background: #1e1e24;
    border: 1px solid rgba(200,169,110,0.12);
    border-radius: 4px;
    overflow: hidden;
    margin-top: 4rem;
  }

  .email-header {
    background: #15151a;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .email-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }

  .email-body {
    padding: 2rem 2.5rem;
  }

  .email-field {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    font-size: 0.78rem;
  }

  .email-field-label {
    color: var(--gris-moyen);
    width: 60px;
    flex-shrink: 0;
  }

  .email-field-value { color: var(--gris-clair); }

  .email-content {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.9;
    color: var(--blanc-casse);
  }

  .email-highlight {
    background: rgba(200,169,110,0.12);
    border-left: 2px solid var(--or);
    padding: 0.8rem 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: var(--or-pale);
    font-size: 0.8rem;
  }

  .email-thumbnail {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(200,169,110,0.1);
    padding: 1.2rem;
    margin: 1.2rem 0;
    border-radius: 2px;
  }

  .thumb-img {
    width: 120px;
    height: 68px;
    background: linear-gradient(135deg, var(--bordeaux) 0%, var(--noir) 100%);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  .thumb-company {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.65rem;
    color: var(--or-pale);
    letter-spacing: 0.1em;
    text-align: center;
    z-index: 1;
  }

  .thumb-x {
    font-size: 0.5rem;
    color: rgba(200,169,110,0.5);
    margin: 2px 0;
    z-index: 1;
  }

  .thumb-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.55rem;
    color: rgba(200,169,110,0.7);
    letter-spacing: 0.05em;
    z-index: 1;
  }

  .thumb-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
  }

  .play-btn {
    width: 24px; height: 24px;
    border-radius: 50%;
    background: rgba(200,169,110,0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.55rem;
    color: var(--noir);
  }

  .thumb-info { font-size: 0.75rem; }
  .thumb-info strong { color: var(--blanc); display: block; margin-bottom: 0.2rem; }
  .thumb-info span { color: var(--gris-moyen); font-size: 0.7rem; }

  /* ─── ROADMAP ─── */
  .roadmap-container {
    position: relative;
  }

  .roadmap-phases {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    margin-bottom: 4rem;
    border: 1px solid rgba(200,169,110,0.1);
  }

  .phase {
    padding: 2.5rem;
    border-right: 1px solid rgba(200,169,110,0.08);
    position: relative;
    transition: background 0.3s;
  }

  .phase:last-child { border-right: none; }
  .phase:hover { background: rgba(26,26,32,0.6); }

  .phase-flag {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .phase-flag.warmup {
    background: rgba(200,169,110,0.1);
    color: var(--or);
    border: 1px solid rgba(200,169,110,0.25);
  }

  .phase-flag.setup {
    background: rgba(124,45,62,0.12);
    color: var(--bordeaux-clair);
    border: 1px solid rgba(124,45,62,0.25);
  }

  .phase-flag.campaign {
    background: rgba(255,255,255,0.04);
    color: var(--blanc-casse);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .phase-dates {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem;
    font-weight: 300;
    color: var(--blanc);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .phase-duration {
    font-size: 0.7rem;
    color: var(--gris-moyen);
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .phase-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .phase-items li {
    font-size: 0.8rem;
    color: var(--gris-clair);
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    line-height: 1.5;
  }

  .phase-items li::before {
    content: '—';
    color: var(--or);
    opacity: 0.4;
    flex-shrink: 0;
    font-size: 0.7rem;
    margin-top: 0.15rem;
  }

  /* ─── TIMELINE BAR ─── */
  .timeline-bar {
    background: var(--verre);
    border: 1px solid rgba(200,169,110,0.08);
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
  }

  .timeline-label {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gris-moyen);
    margin-bottom: 1.2rem;
  }

  .timeline-track {
    height: 6px;
    background: rgba(255,255,255,0.04);
    border-radius: 3px;
    position: relative;
    overflow: visible;
    margin-bottom: 0.8rem;
  }

  .timeline-segment {
    position: absolute;
    height: 100%;
    top: 0;
    border-radius: 3px;
  }

  .seg-warmup {
    left: 0;
    width: 21.4%;
    background: linear-gradient(to right, var(--or), rgba(200,169,110,0.6));
  }

  .seg-campaign {
    left: 21.4%;
    width: 78.6%;
    background: linear-gradient(to right, var(--bordeaux), rgba(124,45,62,0.4));
  }

  .timeline-months {
    display: flex;
    justify-content: space-between;
    margin-top: 0.8rem;
  }

  .timeline-month {
    font-size: 0.62rem;
    color: var(--gris-moyen);
    letter-spacing: 0.05em;
  }

  .timeline-legend {
    display: flex;
    gap: 2rem;
    margin-top: 1.2rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--gris-clair);
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
  }

  /* ─── SEQUENCE ─── */
  .sequence-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: rgba(200,169,110,0.06);
    border: 1px solid rgba(200,169,110,0.08);
    margin-top: 3rem;
  }

  .seq-step {
    background: var(--verre);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: background 0.3s;
  }

  .seq-step:hover { background: rgba(26,26,32,0.95); }

  .seq-day {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    opacity: 0.6;
    margin-bottom: 0.8rem;
  }

  .seq-icon {
    font-size: 1.4rem;
    margin-bottom: 0.8rem;
    display: block;
  }

  .seq-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--blanc);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .seq-desc {
    font-size: 0.72rem;
    color: var(--gris-moyen);
    line-height: 1.6;
  }

  /* ─── METRICS ─── */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(200,169,110,0.06);
    border: 1px solid rgba(200,169,110,0.08);
    margin-top: 3rem;
  }

  .metric-card {
    background: var(--verre);
    padding: 2.5rem 2rem;
    transition: background 0.3s;
  }

  .metric-card:hover { background: rgba(26,26,32,0.9); }

  .metric-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    font-weight: 300;
    color: var(--or);
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }

  .metric-label {
    font-size: 0.72rem;
    color: var(--gris-clair);
    margin-bottom: 0.8rem;
    line-height: 1.4;
  }

  .metric-note {
    font-size: 0.65rem;
    color: var(--gris-moyen);
    font-style: italic;
    line-height: 1.5;
    border-top: 1px solid rgba(255,255,255,0.04);
    padding-top: 0.8rem;
    margin-top: 0.8rem;
  }

  /* ─── FOOTER ─── */
  footer {
    border-top: 1px solid rgba(200,169,110,0.1);
    padding: 4rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .footer-left .footer-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 300;
    color: var(--or);
    margin-bottom: 0.5rem;
  }

  .footer-left p {
    font-size: 0.75rem;
    color: var(--gris-moyen);
  }

  .footer-right {
    text-align: right;
  }

  .footer-right p {
    font-size: 0.72rem;
    color: var(--gris-moyen);
    line-height: 1.8;
  }

  .footer-right a {
    color: var(--or);
    text-decoration: none;
  }

  /* ─── ANIMATIONS ─── */
  .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 768px) {
    nav { padding: 1.2rem 1.5rem; }
    .nav-links { display: none; }
